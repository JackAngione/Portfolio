# Only login POSTs consume the trusted edge limiter; client identity comes from
# nginx's socket peer, never a caller-supplied forwarding header.
map "$request_method:$uri" $session_limit_key {
    default "";
    "POST:/api/session" $binary_remote_addr;
}
limit_req_zone $session_limit_key zone=session_logins:10m rate=30r/m;

upstream apiUpstream {
    # the unified axum backend (media + api on one port)
    server 192.168.0.2:3000;
    keepalive 64;
}
upstream searchUpstream {
    server 192.168.0.2:7700;
    keepalive 64;
}
server {

       server_name jackangione.com www.jackangione.com;

       location / {
       	root /var/www/portfolio;
	try_files $uri /index.html;
	}
	# Proxy requests to Backend API
	  location /api/ {
        limit_req zone=session_logins burst=5 nodelay;
        limit_req_status 429;
    	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    	proxy_set_header Host $http_host;
        
    	proxy_http_version 1.1;
    	proxy_set_header Upgrade $http_upgrade;
    	proxy_set_header Connection "upgrade";
        
    	proxy_pass http://apiUpstream/;
    	proxy_redirect off;
        # Allow the five-minute photo encoder deadline plus response overhead.
        proxy_read_timeout 360s;
        client_max_body_size 100m;
    }
    # Proxy requests to Backend API
	  location /search/ {
    	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    	proxy_set_header Host $http_host;
        
    	proxy_http_version 1.1;
    	proxy_set_header Upgrade $http_upgrade;
    	proxy_set_header Connection "upgrade";
        
    	proxy_pass http://searchUpstream/;
    	proxy_redirect off;
    	proxy_read_timeout 240s;
    }
    
      
    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    add_header Strict-Transport-Security "max-age=31536000" always;
    ssl_certificate /etc/letsencrypt/live/jackangione.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/jackangione.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}
server {
    if ($host = www.jackangione.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = jackangione.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


       listen 80;
       listen [::]:80;

       server_name jackangione.com www.jackangione.com;
    return 404; # managed by Certbot

}
